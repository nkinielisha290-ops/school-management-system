# Copy to .env and adjust. Never commit .env.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Leave empty to use SQLite locally; docker-compose sets this for Postgres.
DATABASE_URL=

# Used by docker-compose for the Postgres container
POSTGRES_DB=school_db
POSTGRES_USER=school_user
POSTGRES_PASSWORD=school_pass

# SMTP (used only when DJANGO_DEBUG=False)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=webmaster@localhost
